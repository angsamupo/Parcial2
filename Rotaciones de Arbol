ROJO = True
NEGRO = False


class Nodo:
  def __init__(self, clave, color=ROJO, padre=None, izq=None, der=None):
    self.clave = clave
    self.color = color
    self.padre = padre
    self.izq = izq
    self.der = der


class ArbolRojoNegro:
  def __init__(self):
    self.nil = Nodo(clave=None, color=NEGRO)
    self.raiz = self.nil

  def rotar_izquierda(self, x):
    y = x.der
    x.der = y.izq

    if y.izq != self.nil:
      y.izq.padre = x

    y.padre = x.padre

    if x.padre == self.nil:
      self.raiz = y
    elif x == x.padre.izq:
      x.padre.izq = y
    else:
      x.padre.der = y

    y.izq = x
    x.padre = y

  def rotar_derecha(self, y):
    x = y.izq
    y.izq = x.der

    if x.der != self.nil:
      x.der.padre = y

    x.padre = y.padre

    if y.padre == self.nil:
      self.raiz = x
    elif y == y.padre.der:
      y.padre.der = x
    else:
      y.padre.izq = x

    x.der = y
    y.padre = x
